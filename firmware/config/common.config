# common base for every build
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y

# initramfs is left at the upstream default on purpose. For every router here it
# is the ONLY way in: their sysupgrade images are 'sysupgrade-tar', which no
# bootloader can write to flash, so a first install must tftp an initramfs image
# and run sysupgrade from the OpenWrt it boots. Targets opting out say so in
# their own overlay (see x86.config).

# third-party plugins every build gets; packages.ini clones their repos.
# Anything only some builds have room for goes in firmware/config/<name>.config instead.
#
# Proxy policy: passwall2 is the ONE default proxy, on every device. Any proxy
# app beyond it (nikki, openclash) is never a default — it is granted per
# device, to big-RAM/big-flash hardware only, in that build's overlay:
# nikki on x86 and the 256MB tr3000, openclash on Arthur. See those files.
CONFIG_PACKAGE_luci-app-passwall2=y
# passwall2 defaults this backend on for aarch64/x86_64, and it is the single
# most expensive thing in the whole pipeline: shadowsocks-rust drags in the rust
# host toolchain, which is built from source on every run — 96-109 min per
# build, measured on all three. No cache can absorb it, because the stamp make
# tests for is HOST_BUILD_DIR/.built under build_dir/, and build_dir is not
# cached anywhere (a full rustc build tree is ~20GB against a 10GB quota).
# Dropping it costs nothing: passwall2 picks the SS core from a fallback chain
# (subscribe.lua: shadowsocks-rust -> sing-box -> xray), so SS nodes land on
# sing-box instead, which speaks the protocol just as well. The SIP003 plugins
# stay in (Simple_Obfs, V2ray_Plugin) — sing-box needs those binaries to run an
# obfuscated SS node, and they cost seconds to build.
# The second line is a tripwire, not a duplicate: if the INCLUDE symbol is ever
# renamed upstream, this one fails the guard in ~8 min instead of silently
# handing back the 109-minute rust build.
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_shadowsocks-rust-sslocal=n
CONFIG_PACKAGE_luci-theme-shadcn=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
